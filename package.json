{
  "name": "dsh-vnc-client",
  "version": "0.1.0",
  "description": "VNC client tab for the DeepSeek Harness right sidebar: an RFB client that connects to any VNC/RFB server over a WebSocket-to-TCP bridge running in the Host",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "vnc",
    "rfb",
    "vnc-client",
    "remote-desktop",
    "screen-sharing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonchengassistant/dsh-vnc-client.git"
  },
  "homepage": "https://github.com/wilsonchengassistant/dsh-vnc-client#readme",
  "bugs": {
    "url": "https://github.com/wilsonchengassistant/dsh-vnc-client/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/websocket.js",
    "lib/targets.js",
    "lib/client.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
